{
  "name": "create-tailwind-app",
  "version": "1.0.1",
  "description": "Build the HTML template with tailwind css.",
  "homepage": "https://krishnakamble759.github.io/brew-and-bites/",
  "type": "commonjs",
  "scripts": {
    "start": "live-server ./public ",
    "tailwind": "tailwindcss  -i css/main.css -o public/assets/css/build/tailwind.css --minify  & live-server ./public ",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "HTML template",
    "tailwindcss",
    "tailwind",
    "HTML",
    " css framework"
  ],
  "author": "Rajdeep Singh",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^5.1.9",
    "gh-pages": "^6.3.0",
    "live-server": "^1.2.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^9.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^12.23.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "swiper": "^11.2.10",
    "yet-another-react-lightbox": "^3.25.0"
  }
}
